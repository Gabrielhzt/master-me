# Port this API listens on
PORT=3001

# development | test | production
NODE_ENV=development

# Origin of the frontend allowed to call this API (used for CORS)
CLIENT_URL=http://localhost:3000

# Postgres connection string (local, or a Neon/hosted URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/master-me

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-minimum-secret

# This API's own origin, where auth routes are mounted
BETTER_AUTH_URL=http://localhost:3001

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be onboarding@resend.dev until you verify a sending domain
EMAIL_FROM=onboarding@resend.dev
